#!/usr/bin/env bash
# 统一基础应用版本/来源配置（供 apps/sync-base-apps.sh 读取）

# Chrome
CHROME_DEB_URL="${CHROME_DEB_URL:-https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb}"

# GitHub Desktop（社区包源）
# 说明：https://apt.packages.shiftkey.dev 曾出现 TLS 证书与域名不匹配（CDN 配置问题），
# 与 shiftkey/desktop README 一致，默认改用 mwt 镜像；可自行改回 shiftkey 并确认证书已修复。
GITHUB_DESKTOP_GPG_URL="${GITHUB_DESKTOP_GPG_URL:-https://mirror.mwt.me/shiftkey-desktop/gpgkey}"
GITHUB_DESKTOP_APT_DEB="${GITHUB_DESKTOP_APT_DEB:-https://mirror.mwt.me/shiftkey-desktop/deb/}"

# 可选：若填写 .deb 直链，apps/download-base-apps.sh 会下载到 shared_apps/downloads/github-desktop.deb（不在容器内自动安装）。
GITHUB_DESKTOP_DEB_URL="${GITHUB_DESKTOP_DEB_URL:-}"

# Cursor (AppImage)
# 默认用 API 拿到当前稳定版直链（downloads.cursor.com），避免旧 downloader 域名在部分代理下 TLS EOF。
CURSOR_APPIMAGE_URL="${CURSOR_APPIMAGE_URL:-https://www.cursor.com/api/download?platform=linux-x64&releaseTrack=stable}"
CURSOR_APPIMAGE_NAME="${CURSOR_APPIMAGE_NAME:-cursor-latest.AppImage}"

# Claude Code (npm 包与版本)
CLAUDE_CODE_NPM_PKG="${CLAUDE_CODE_NPM_PKG:-@anthropic-ai/claude-code}"
CLAUDE_CODE_NPM_VER="${CLAUDE_CODE_NPM_VER:-latest}"
